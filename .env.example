# Ollama
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=24576
MAX_AGENT_STEPS=80

# Optional project paths
# Additional absolute directories the agent may read/write/build in.
# Use semicolons between roots. Grant only the specific project folders needed.
# Example: AI_CODER_ALLOWED_ROOTS=D:/Games/rougeLikeGame;D:/Projects/AnotherGame
# AI_CODER_ROOT=D:\AI-Coder-C++
# AI_CODER_WORKSPACE=workspace
# AI_CODER_LOG_DIR=logs

# C++ toolchain
# VCPKG_ROOT=D:\AI-Coder-C++\tools\vcpkg

# Keep false to require confirmation before running build/run operations.
AI_CODER_AUTO_APPROVE=false
